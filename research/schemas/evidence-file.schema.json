{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratemai.com/schemas/evidence-file/v0.3.json",
  "title": "Wayfinder evidence file",
  "description": "One research run's evidence, shared by research-corpus and answer-engine-check. Evidence files are client data: they are stored with the run and never committed to stratemai-skills.",
  "type": "object",
  "required": [
    "schema_version",
    "run",
    "probe_responses",
    "labels"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "run": {
      "description": "Run metadata.",
      "type": "object",
      "required": [
        "run_id",
        "subject",
        "frame_id",
        "prompt_set_hash",
        "dates",
        "collectors",
        "failures"
      ],
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string"
        },
        "subject": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "product_lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "frame_id": {
          "type": "string",
          "description": "Research frame identifier in research-corpus."
        },
        "prompt_set_hash": {
          "type": "string",
          "description": "Hash of the frozen prompt set, recorded before the first pull."
        },
        "dates": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "locale": {
          "type": "string",
          "description": "Market and device, e.g. US desktop."
        },
        "collectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              }
            }
          }
        },
        "failures": {
          "description": "Errors, timeouts and empty answers, recorded as failures and left out of denominators. An answer given without searching is not a failure: it stays in the data with searched=false.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "prompt_id",
              "engine",
              "date",
              "kind"
            ],
            "properties": {
              "prompt_id": {
                "type": "string"
              },
              "engine": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "rep": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "error",
                  "timeout",
                  "empty",
                  "refused",
                  "other"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "corpus": {
      "description": "The subject's own pages and how they link.",
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "fetched"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "fetched": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "raw_word_count": {
                "type": "integer",
                "minimum": 0
              },
              "rendered_word_count": {
                "type": "integer",
                "minimum": 0
              },
              "late_share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "From the rendering check."
              }
            }
          }
        },
        "link_graph": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "format": "uri"
              },
              "to": {
                "type": "string",
                "format": "uri"
              },
              "anchor": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "structured_data": {
      "description": "Schema.org and similar markup found and expected-but-absent, per page.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "found": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "absent": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "external_knowledge": {
      "description": "Presence of the subject in external knowledge sources (Wikipedia, Wikidata, knowledge panels, review sites).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "present",
          "checked"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "present": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checked": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "probe_responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "response_id",
          "prompt_id",
          "engine",
          "model",
          "date",
          "rep",
          "text",
          "citations"
        ],
        "properties": {
          "response_id": {
            "type": "string"
          },
          "prompt_id": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "branded": {
            "type": "boolean"
          },
          "engine": {
            "type": "string",
            "description": "e.g. chatgpt, gemini, perplexity, google_aio."
          },
          "model": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "rep": {
            "type": "integer",
            "minimum": 1
          },
          "searched": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the engine searched. Null when the surface does not say."
          },
          "text": {
            "type": "string",
            "description": "Verbatim answer text."
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "class"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "domain": {
                  "type": "string"
                },
                "position": {
                  "type": "integer",
                  "minimum": 1
                },
                "class": {
                  "enum": [
                    "competitor_owned",
                    "review_or_listicle",
                    "reddit",
                    "client_owned",
                    "other",
                    "unknown",
                    "source_about_others"
                  ]
                },
                "class_pass": {
                  "enum": [
                    "known_domain",
                    "unknown_domain_pass"
                  ],
                  "description": "Which citation-classes pass assigned the class."
                }
              }
            }
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "response_id",
          "labeller"
        ],
        "properties": {
          "response_id": {
            "type": "string"
          },
          "named": {
            "type": "boolean"
          },
          "recommended": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "recommendation_level": {
            "enum": [
              "top_pick",
              "recommended_among_others",
              "mentioned_not_recommended",
              "not_applicable",
              null
            ],
            "description": "not_applicable when the subject is not named."
          },
          "claims": {
            "description": "Claims matched against the truth sheet.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "claim_id",
                "result"
              ],
              "properties": {
                "claim_id": {
                  "type": "string"
                },
                "result": {
                  "enum": [
                    "matches",
                    "contradicts",
                    "absent"
                  ]
                },
                "evidence_span": {
                  "type": "string"
                }
              }
            }
          },
          "labeller": {
            "type": "object",
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "code",
                  "person"
                ]
              },
              "id": {
                "type": "string",
                "description": "Script name and version, or the person's name."
              }
            }
          },
          "human_audit_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Identifier of the Human Audit that validates this label scheme."
          }
        }
      }
    },
    "truth_sheet": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "statement",
          "source"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "verified_by": {
            "type": "string"
          },
          "verified_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "derived_numbers": {
      "description": "Every number computed from this file. Each carries origin, kind and grade; the lane is looked up from origin + kind (research/evidence-lanes).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "surface",
          "dates",
          "level",
          "origin",
          "kind",
          "grade",
          "lane",
          "recomputed",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "numerator": {
            "type": "integer",
            "minimum": 0
          },
          "denominator": {
            "type": "integer",
            "minimum": 1
          },
          "value": {
            "type": "number",
            "description": "For figures that are not a count over a count: a modeled volume, a reported growth rate, a difference in points, a variance share."
          },
          "unit": {
            "type": "string",
            "description": "Unit for value, e.g. percent, points, prompts, USD."
          },
          "surface": {
            "type": "string"
          },
          "prompt_set_hash": {
            "type": "string"
          },
          "dates": {
            "type": "string",
            "description": "Required. Collection dates, or the date of the source."
          },
          "level": {
            "enum": [
              "answer",
              "citation",
              "page",
              "prompt",
              "other"
            ]
          },
          "interval": {
            "type": "object",
            "required": [
              "low",
              "high",
              "method"
            ],
            "properties": {
              "low": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "method": {
                "enum": [
                  "wilson",
                  "prompt_bootstrap",
                  "wilson_effective_n",
                  "t_interval",
                  "paired_permutation",
                  "other"
                ]
              },
              "level": {
                "const": 0.95
              }
            }
          },
          "origin": {
            "enum": [
              "stratemai",
              "client",
              "vendor",
              "independent",
              "public"
            ],
            "description": "Who produced it."
          },
          "kind": {
            "enum": [
              "observed",
              "modeled",
              "stated",
              "finding",
              "opinion"
            ],
            "description": "What sort of evidence it is."
          },
          "grade": {
            "enum": [
              "A",
              "B",
              "C"
            ],
            "description": "Fitness for this specific use, per the source registry."
          },
          "source_id": {
            "type": "string",
            "description": "Source registry id."
          },
          "lane": {
            "enum": [
              "custom_research",
              "stratemai_research",
              "client_public_sources",
              "client_reported",
              "third_party_tool",
              "published_research",
              "public_commentary"
            ],
            "description": "Looked up from origin + kind; never chosen by hand."
          },
          "recomputed": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "yes",
                  "not_yet"
                ]
              },
              "by": {
                "type": "string",
                "description": "Code that recomputed it, separate from the collector."
              },
              "on": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "retired": {
            "type": "object",
            "properties": {
              "on": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "result": {
            "enum": [
              "established",
              "inconclusive_not_significant",
              "too_small_to_judge",
              "descriptive"
            ],
            "description": "descriptive for plain rates; the other three for tests and audits. Only established or descriptive figures may reach a client."
          }
        },
        "allOf": [
          {
            "oneOf": [
              {
                "properties": {
                  "origin": {
                    "const": "stratemai"
                  },
                  "kind": {
                    "const": "observed"
                  },
                  "lane": {
                    "const": "custom_research"
                  }
                }
              },
              {
                "properties": {
                  "origin": {
                    "const": "stratemai"
                  },
                  "kind": {
                    "const": "finding"
                  },
                  "lane": {
                    "const": "stratemai_research"
                  }
                }
              },
              {
                "properties": {
                  "origin": {
                    "const": "client"
                  },
                  "kind": {
                    "const": "observed"
                  },
                  "lane": {
                    "const": "client_public_sources"
                  }
                }
              },
              {
                "properties": {
                  "origin": {
                    "const": "client"
                  },
                  "kind": {
                    "const": "stated"
                  },
                  "lane": {
                    "const": "client_reported"
                  }
                }
              },
              {
                "properties": {
                  "origin": {
                    "const": "vendor"
                  },
                  "kind": {
                    "const": "modeled"
                  },
                  "lane": {
                    "const": "third_party_tool"
                  }
                }
              },
              {
                "properties": {
                  "origin": {
                    "const": "vendor"
                  },
                  "kind": {
                    "const": "observed"
                  },
                  "lane": {
                    "const": "third_party_tool"
                  }
                }
              },
              {
                "properties": {
                  "origin": {
                    "const": "independent"
                  },
                  "kind": {
                    "const": "finding"
                  },
                  "lane": {
                    "const": "published_research"
                  }
                }
              },
              {
                "properties": {
                  "origin": {
                    "const": "public"
                  },
                  "kind": {
                    "const": "opinion"
                  },
                  "lane": {
                    "const": "public_commentary"
                  }
                }
              }
            ]
          },
          {
            "oneOf": [
              {
                "required": [
                  "numerator",
                  "denominator",
                  "interval"
                ]
              },
              {
                "required": [
                  "value",
                  "unit"
                ],
                "not": {
                  "required": [
                    "numerator"
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  }
}
